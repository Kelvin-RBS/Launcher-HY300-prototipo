# Dados do aparelho: software proprietário e identificadores
*.apk
props.txt
*_dump.txt
settings_*.txt
apps_*.txt
tv_input.txt
*.png
!prototype/assets/*

# Chaves de assinatura e configuração local do Android: NUNCA publicar
*.jks
*.keystore
keystore.properties
local.properties
.gradle/
build/
.idea/
*.iml
captures/
.externalNativeBuild/
.cxx/

# Jogos (ROMs): nunca publicar. Só ficam o README e os .gitkeep
jogos/*/*
!jogos/*/.gitkeep
*.sfc
*.smc
*.swc
*.fig
*.smd
*.gen

# Núcleos de emulador (licença não comercial do Snes9x): nunca publicar
android/games/src/main/jniLibs/**/*.so
*_libretro_android.so
*_libretro_android.so.zip
